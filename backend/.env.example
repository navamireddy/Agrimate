# ─────────────────────────────────────────────────────
# AGRIMATE BACKEND — Environment Variables
# Copy this file to .env and fill in your real values
# ─────────────────────────────────────────────────────

# MongoDB connection string (MongoDB Atlas or local)
# Get free cluster at: https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrimate?retryWrites=true&w=majority

# JWT secret — use a long random string (32+ chars)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_abc123xyz

# OpenWeatherMap API key (free tier works fine)
# Sign up at: https://openweathermap.org/api
WEATHER_KEY=your_openweathermap_api_key_here

# Port (optional, defaults to 5000)
PORT=5000
